{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "workflow": {
      "type": "string",
      "const": "record_birth"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scope": {
            "type": "string",
            "enum": ["event", "offspring"]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "required": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "default": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "literal"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 80
                        }
                      }
                    ]
                  }
                },
                "required": ["kind", "value"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "today"
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              }
            ]
          },
          "unit": {
            "type": "string",
            "enum": ["kg", "lb"]
          },
          "type": {
            "type": "string",
            "enum": ["text", "number", "boolean", "date", "choice"]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": ["key", "label"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": ["key", "scope", "label"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": ["schema_version", "workflow", "name", "fields"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
